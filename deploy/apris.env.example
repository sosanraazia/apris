# /etc/apris/apris.env — lives on the VM only, never in git. chmod 640, owner root:apris
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
APP_DOMAIN=apris.dsu.edu.pk

# Branch the VM deploys from
APRIS_BRANCH=clean-main

# Long random string (32+ chars): openssl rand -base64 48
SESSION_SECRET=CHANGE_ME

# Data lives OUTSIDE the git checkout so deploys never touch it
DATABASE_URL=file:/var/lib/apris/apris.db
STORAGE_DIR=/var/lib/apris/storage

# Used once, by the first install, to create the admin account (12+ chars). Remove afterwards.
INITIAL_ADMIN_PASSWORD=

# ---- Student e-mail (see docs/ADMIN_RUNBOOK.md, section A11) ----
# Ask university IT for an SMTP relay / mail account that may send as no-reply@dsu.edu.pk.
EMAIL_MODE=smtp
EMAIL_FROM="DSU Registration <no-reply@dsu.edu.pk>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false          # true for port 465 (implicit TLS); false = STARTTLS on 587
SMTP_USER=
SMTP_PASS=
# Replies to a student's email go to the advisor who committed the registration (their email is set under
# Admin -> Manage users). This address is only the fallback when no advisor address exists (optional):
# EMAIL_DEFAULT_REPLY_TO=registration@dsu.edu.pk
# PILOT: send every email to this address instead of the students (remove at go-live)
# EMAIL_REDIRECT_TO=advisor@dsu.edu.pk

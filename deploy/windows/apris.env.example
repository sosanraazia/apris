# C:\apris\config\apris.env — lives on the server only, never in git. KEY=VALUE per line, no quotes needed.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
APP_DOMAIN=apris.dsu.edu.pk

# Branch the server deploys from
APRIS_BRANCH=clean-main

# Long random string (32+ chars). install.ps1 generates one.
SESSION_SECRET=CHANGE_ME

# Data lives OUTSIDE the release folders so deploys never touch it. Forward slashes in the database URL.
DATABASE_URL=file:C:/apris/data/apris.db
STORAGE_DIR=C:\apris\data\storage

# Used once, by the first install, to create the admin account (6+ chars). install.ps1 removes it afterwards.
INITIAL_ADMIN_PASSWORD=

# ---- Student e-mail (see docs/ADMIN_RUNBOOK.md, section A11) ----
EMAIL_MODE=smtp
EMAIL_FROM=DSU Registration <no-reply@dsu.edu.pk>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# EMAIL_DEFAULT_REPLY_TO=registration@dsu.edu.pk
# PILOT: send every email to this address instead of the students (remove at go-live)
# EMAIL_REDIRECT_TO=advisor@dsu.edu.pk

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  email        String   @unique
  name         String
  passwordHash String?
  mustChangePassword Boolean @default(false)
  role         String // ADMIN | HOD | ADVISOR
  department   String?
  authProvider String   @default("LOCAL") // LOCAL | LDAP | ACTIVE_DIRECTORY | ENTRA_ID
  externalId   String?
  active       Boolean  @default(true)
  batches      String   @default("") // advisors: comma-separated batches they advise, e.g. "CYS23,CYS24"
  students     Student[]
}

model Setting {
  key   String @id
  value String // JSON
}

model Pos {
  id            Int         @id @default(autoincrement())
  posCode       String // BS-SE-2024
  program       String // SE | CYS
  year          Int
  variant       String // REGULAR | MINORITIES | PREMED | MINORITIES_PREMED | SPECIAL
  totalRequired Int
  published     Boolean     @default(false)
  courses       PosCourse[]
  students      Student[]

  @@unique([posCode, variant])
}

model PosCourse {
  id            Int     @id @default(autoincrement())
  posId         Int
  pos           Pos     @relation(fields: [posId], references: [id], onDelete: Cascade)
  semester      Int
  seq           Int
  code          String
  title         String
  ch            Int
  isPlaceholder Boolean @default(false)
}

model Prerequisite {
  id           Int    @id @default(autoincrement())
  course       String
  prerequisite String
  rule         String @default("Must Pass")
}

model Semester {
  id            Int        @id @default(autoincrement())
  name          String     @unique // Fall 2026
  active        Boolean    @default(false)
  phase         String     @default("REGISTRATION") // REGISTRATION | ADD_DROP | CLOSED
  addDropEnds   DateTime? // when phase is ADD_DROP, it auto-closes after this instant
  openedAt      DateTime? // set when an Admin opens the semester in the app (null for the seeded one)
  offerings     Offering[]
  registrations Registration[]
}

model Offering {
  id         Int      @id @default(autoincrement())
  semesterId Int
  semester   Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  sheet      String
  program    String?
  courseCode String
  courseName String
  section    String?
  cbaCode    String?
  preMedOnly Boolean  @default(false)
  issues     String   @default("[]") // JSON string[]
  active     Boolean  @default(true)
}

model Student {
  id             Int        @id @default(autoincrement())
  registrationId String     @unique
  name           String
  fatherName     String?
  program        String
  admission      String?
  homeSection    String?
  standing       String     @default("NORMAL")
  posId          Int?
  pos            Pos?       @relation(fields: [posId], references: [id])
  advisorId      Int?
  advisor        User?      @relation(fields: [advisorId], references: [id])
  createdAt      DateTime   @default(now())
  archivedAt     DateTime? // soft delete: only an Admin can archive; records are never removed
  archivedReason String?
  notifications  Notification[]
  snapshots      Snapshot[]
  registrations  Registration[]
  email          String
}

/// One per (transcript, fulfillment) pair uploaded. Latest verified = active.
model Snapshot {
  id           Int      @id @default(autoincrement())
  studentId    Int
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())
  verifiedById Int?
  active       Boolean  @default(true)
  cgpa         Float?
  completedCH  Int
  requiredCH   Int?
  homeSection  String?
  courses      String // JSON TranscriptCourse[]
  terms        String // JSON TranscriptTerm[]
  warnings     String   @default("[]")
  transcriptFile String?
  fulfillmentFile String?
}

model Registration {
  id         Int      @id @default(autoincrement())
  studentId  Int
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  semesterId Int
  semester   Semester @relation(fields: [semesterId], references: [id])
  status     String   @default("DRAFT") // DRAFT | APPROVED | FINALIZED | EXPORTED
  version    Int      @default(0)
  removals   String   @default("[]") // JSON [{code,title,reason}] recommended courses the advisor dropped
  updatedAt  DateTime @updatedAt
  items      RegistrationItem[]
  versions   RegistrationVersion[]

  @@unique([studentId, semesterId])
}

model RegistrationItem {
  id             Int          @id @default(autoincrement())
  registrationId Int
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  posCourseCode  String?
  offeringId     Int
  recommended    Boolean      @default(false) // matches engine suggestion
  reason         String? // recommendation reason
  overrideReason String?
}

model RegistrationVersion {
  id             Int          @id @default(autoincrement())
  registrationId Int
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  version        Int
  items          String // JSON snapshot of final course set
  changes        String // JSON diff vs previous version
  reason         String?
  phase          String       @default("REGISTRATION") // phase in force when this version was committed
  userId         Int
  createdAt      DateTime     @default(now())
  notification   String       @default("NOT_QUEUED") // placeholder for Phase 5 email
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  at        DateTime @default(now())
  userId    Int?
  action    String
  studentRegId String?
  before    String?
  after     String?
  reason    String?
  prevHash  String? // tamper evidence: each row commits to the one before it
  hash      String?

  @@index([userId])
  @@index([studentRegId])
  @@index([action])
}

/// Outbound e-mail queue. Rows are written in the same transaction as the registration version they describe,
/// so a committed change always has its notification, and a mail failure can never roll a registration back.
model Notification {
  id             Int       @id @default(autoincrement())
  idempotencyKey String    @unique // studentId:semesterId:version:event — repeated actions can't create duplicates
  studentId      Int
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  studentRegId   String
  semesterId     Int
  versionId      Int?
  eventType      String // ENROLLMENT_FINALIZED | ENROLLMENT_CHANGED | TEST
  toEmail        String
  replyTo        String? // the responsible advisor's email, captured when the registration was committed
  subject        String
  textBody       String
  htmlBody       String
  status         String    @default("QUEUED") // QUEUED | SENDING | SENT | RETRYING | FAILED
  attempts       Int       @default(0)
  lastError      String?
  nextAttemptAt  DateTime  @default(now())
  sentAt         DateTime?
  transport      String? // smtp | log | redirect-smtp
  createdAt      DateTime  @default(now())

  @@index([status, nextAttemptAt])
  @@index([studentId])
}

/// Known class sections per student, extracted from the departments' Award Lists (gradebooks). Holds only what is needed to
/// suggest a home section: no names, no grades. `regular` = the student's batch matches the section's semester
/// (false = a backlog attendee from another batch, so it says nothing about their own home section).
model SectionRoster {
  id             Int      @id @default(autoincrement())
  registrationId String
  program        String // SE | CYS
  term           String // "Spring 2026"
  sourceSection  String // "SE-2A"
  regular        Boolean
  courseCode     String?
  uploadedById   Int?
  uploadedAt     DateTime @default(now())

  @@unique([registrationId, term, sourceSection])
  @@index([registrationId])
}

/// Which real course fills an elective slot of a Plan of Study (all variants of a POS share it).
/// courseTitle null = slot deliberately unassigned ("N/A"): no course has been announced for it yet.
model ElectiveMapping {
  id          Int     @id @default(autoincrement())
  posCode     String // BS-SE-2020
  category    String // UNIVERSITY | DOMAIN
  slot        Int // 1-based slot number inside the category
  semester    Int? // semester the POS places the slot in (informational)
  courseTitle String?
  titleKey    String? // courseKey() of courseTitle, used for matching

  @@unique([posCode, category, slot])
}
